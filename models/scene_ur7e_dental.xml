<mujoco model="ur7e_dental_scene">
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.75 0.75 0.75"
      specular="0.2 0.2 0.2"/>
  </visual>

  <asset>
    <model name="ur7e_tool" file="universal_robots_ur5e/ur7e_with_tool.xml"/>
    <model name="dental_static" file="dental_static_component.xml"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="3 3 0.1"
      rgba="0.88 0.88 0.88 1" contype="0" conaffinity="0"/>
    <light name="main_light" pos="0 -2 3" dir="0 1 -1"
      diffuse="0.9 0.9 0.9"/>
    <camera name="scene_camera" pos="2 -2 1.8"
      xyaxes="0.707 0.707 0 -0.408 0.408 0.816"/>
    <camera name="global_dental_camera"
      pos="0.305579287 -1.177246219 1.368086855"
      quat="0.898576218 -0.435547443 0.020527300 0.049374447"
      fovy="30"/>

    <body name="robot_mount" pos="0.815 -0.90 0.77"
      quat="0.707106781 0 0 0.707106781">
      <attach model="ur7e_tool" body="base" prefix="ur_"/>
    </body>
    <body name="dental_mount">
      <attach model="dental_static" body="static_root" prefix="dental_"/>
    </body>
  </worldbody>
</mujoco>
